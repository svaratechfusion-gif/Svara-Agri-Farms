# Copy to .env.local for local work. On Vercel, set these in the project's
# Environment Variables; the Neon integration sets the two database URLs.
# Never put a connection string in a NEXT_PUBLIC_* variable.

# Server only. Neon pooled connection string (host contains "-pooler").
DATABASE_URL=

# Optional. Neon direct connection string, preferred by db:migrate and db:seed.
DATABASE_URL_UNPOOLED=

# Optional. Public origin of the site, e.g. https://your-domain. Falls back to
# Vercel's production URL. Production builds take it from .env.production.
NEXT_PUBLIC_SITE_URL=

# Where order requests are saved. Off (requests refused) when unset.
#   database  PostgreSQL at DATABASE_URL — any host. Run db:migrate and db:seed first.
#   file      JSON files in ORDER_REQUESTS_DIR — one long-running server only, not Vercel.
ORDER_REQUESTS_STORE=
ORDER_REQUESTS_DIR=

# No payment provider is connected. Its server-only secrets go here once one is
# chosen (see README, "Payment"). Never put a secret in a NEXT_PUBLIC_* variable.
