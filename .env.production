# Loaded by `next build` / `next start` for production builds (local and Vercel).
# Public values only — this file is committed. Secrets belong in the Vercel
# project's Environment Variables, never here or in any NEXT_PUBLIC_* variable.

# The canonical origin: canonical URLs, Open Graph, structured data, the
# sitemap and robots.txt are all built from it. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://svaraagrifarms.vercel.app

# Google Analytics 4, loaded directly with gtag.js (public ID, not a secret).
NEXT_PUBLIC_GA4_ID=G-7X6NW0X8MJ

# Google Tag Manager container (public ID, not a secret). It must not also send
# to the GA4 property above, or events count twice: docs/analytics.md.
NEXT_PUBLIC_GTM_ID=GTM-5PKWRX73
